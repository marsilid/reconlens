{% extends "base.html.j2" %}
{% from "macros.html.j2" import render %}
{% block title %}ReconLens report — {{ report.target }}{% endblock %}
{% block content %}
  <header class="top">
    <span class="brand">ReconLens</span>
    <span class="meta">
      {{ report.started_at.strftime("%Y-%m-%d %H:%M UTC") }} · {{ "%.1f" | format(report.duration) }}s ·
      {{ report.results | length }} modules · DNS: {{ report.dns_backend }}
    </span>
  </header>
  <h1>{{ report.target }}</h1>
  {% for note in report.notes %}
  <p class="card note">{{ note }}</p>
  {% endfor %}

  <section class="card summary">
    <div class="grade grade-{{ report.grade }}">{{ report.grade }}</div>
    <div>
      <div class="score"><strong>{{ report.score }}</strong> / 100 security posture score</div>
      <div class="counts">
        {% for label, count in report.severity_counts.items() %}
        <span class="chip sev-{{ label }}"><span class="dot"></span><span style="color:var(--text)">{{ count }} {{ label }}</span></span>
        {% endfor %}
      </div>
    </div>
  </section>

  <h2>Findings</h2>
  {% for f in report.findings %}
  <article class="card finding sev-{{ f.severity.label }}">
    <div class="head">
      <span class="badge"><span>{{ f.severity.label }}</span></span>
      <h3>{{ f.title }}</h3>
      <span class="module">{{ f.module }}</span>
    </div>
    {% if f.description %}<p>{{ f.description | codespans }}</p>{% endif %}
    {% if f.recommendation %}<p class="fix">{{ f.recommendation | codespans }}</p>{% endif %}
  </article>
  {% else %}
  <p class="empty">No findings. Nice.</p>
  {% endfor %}

  <h2>Collected data</h2>
  {% for r in report.results %}
  <details class="card module"{% if r.error %} open{% endif %}>
    <summary>
      {{ r.title }}
      <span class="muted">{{ "%.1f" | format(r.duration) }}s · {{ r.findings | length }} findings</span>
    </summary>
    <div class="body">
      {% if r.error %}<p class="error">Module failed: {{ r.error }}</p>{% endif %}
      {% if r.data %}{{ render(r.data) }}{% elif not r.error %}<span class="empty">no data</span>{% endif %}
    </div>
  </details>
  {% endfor %}

  <footer>
    Generated by ReconLens v{{ version }}. Passive reconnaissance based on public sources
    (DNS, Certificate Transparency, WHOIS/RDAP, public web pages). The score is a triage aid,
    not a penetration test. Use only on assets you own or are authorised to assess.
  </footer>
{% endblock %}
