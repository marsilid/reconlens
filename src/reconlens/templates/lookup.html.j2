{% extends "base.html.j2" %}
{% from "macros.html.j2" import render %}
{% block title %}ReconLens — {{ kind }}: {{ target }}{% endblock %}
{% block content %}
  <header class="top">
    <span class="brand">ReconLens</span>
    <span class="meta">{{ generated_at.strftime("%Y-%m-%d %H:%M UTC") }} · {{ kind }} lookup</span>
  </header>
  <h1>{{ target }}</h1>
  {% for note in notes %}
  <p class="card note">{{ note }}</p>
  {% endfor %}

  {% if summary %}
  <section class="card summary" style="display:block">
    {% for label, value in summary.items() %}
    <div class="score" style="margin:0 0 6px">{{ label }}: <strong style="font-size:16px">{{ value }}</strong></div>
    {% endfor %}
  </section>
  {% endif %}

  {% for section in sections %}
  <h2>{{ section.title }}</h2>
  {% if section.get("rows") is not none %}
    {{ render(section["rows"]) }}
  {% else %}
    <div class="card">{{ render(section["data"]) }}</div>
  {% endif %}
  {% endfor %}

  <footer>
    Generated by ReconLens v{{ version }}. {{ disclaimer }}
  </footer>
{% endblock %}
